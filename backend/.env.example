# DermaSense AI Backend Environment Variables
# Copy to .env for local development

# Ollama Configuration
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
OLLAMA_TIMEOUT=120

# Skin AI Model
SKIN_MODEL_PATH=models/skin_model.keras
SKIN_MODEL_INPUT_SIZE=224

# Confidence Thresholds (0.0 - 1.0)
CONFIDENCE_HIGH=0.80
CONFIDENCE_MODERATE=0.60

# CORS
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173

# Supabase Configuration
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=
DATABASE_URL=
