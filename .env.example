# ─── DermaSense AI Production Environment Variables ──────────────────────────
# Copy this file to .env.local for development and set values in your hosting
# platform's secrets manager for production.
# NEVER commit .env.local or any file containing real secrets to version control.

# ─── Application ──────────────────────────────────────────────────────────────
VITE_APP_NAME=DermaSense AI
VITE_APP_VERSION=8.0.0
VITE_APP_ENV=production

# ─── Backend API ──────────────────────────────────────────────────────────────
# Base URL for your production backend REST API
VITE_API_BASE_URL=https://api.dermasense.ai/v1

# ─── Authentication (Firebase / Supabase / Custom) ────────────────────────────
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
VITE_GOOGLE_CLIENT_ID=your_google_oauth_client_id

# ─── AI Services ──────────────────────────────────────────────────────────────
# Skincare AI Model API endpoint (never expose private keys in frontend)
VITE_SKINCARE_AI_API_URL=https://ai.dermasense.ai/skincare
# Disease Screening AI Model API endpoint
VITE_DISEASE_AI_API_URL=https://ai.dermasense.ai/disease

# ─── Payment Gateway (Razorpay) ───────────────────────────────────────────────
# Use the PUBLIC key only (never the secret key) in the frontend
VITE_RAZORPAY_KEY_ID=rzp_test_your_test_key_id

# ─── Storage ──────────────────────────────────────────────────────────────────
VITE_STORAGE_BUCKET_URL=https://storage.googleapis.com/your-bucket

# ─── Feature Flags (Override defaults) ───────────────────────────────────────
VITE_ENABLE_SKINCARE_AI=true
VITE_ENABLE_DISEASE_AI=true
VITE_ENABLE_TELEHEALTH_VIDEO=true
VITE_ENABLE_PAYMENTS=true
VITE_ENABLE_MAINTENANCE_MODE=false

# ─── Error Monitoring (Sentry) ────────────────────────────────────────────────
# Never send sensitive medical data to error monitoring services
VITE_SENTRY_DSN=https://your_sentry_dsn@sentry.io/project_id

# ─── Deployment Configuration ─────────────────────────────────────────────────
# Production domain for HTTPS, CORS, and OAuth callback URLs
VITE_PRODUCTION_DOMAIN=https://dermasense.ai
